// MYSQL
CREATE TABLE users (
	ID INT AUTO_INCREMENT PRIMARY KEY,
    NAME VARCHAR(50),
    EMAIL VARCHAR(100),
    PASSWORD VARCHAR(100),
    ROLE VARCHAR(100),
    STATUS VARCHAR(100),
    CREATED_AT DATE,
    UPDATED_AT DATE
);

// POSTGRES
CREATE TABLE users (
    id INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    name VARCHAR(50),
    email VARCHAR(100),
    password VARCHAR(100),
    role VARCHAR(100),
    status VARCHAR(100),
    created_at DATE,
    updated_at DATE
);